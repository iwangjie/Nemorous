+
+    /// The current vertical offset. Tracks changes when read in an effect.
+    pub fn vertical_scroll_offset(&self) -> Points {
+        self.ed.scroll_y.get()
+    }
+
+    /// The last reachable vertical offset for the current viewport.
+    pub fn max_vertical_scroll_offset(&self) -> Points {
+        (self.ed.content_height.get_untracked() - self.ed.viewport.get_untracked().height)
+            .max(px(0.0))
+    }
+
+    /// Scrolls vertically, preserving the horizontal offset and selection.
+    pub fn set_vertical_scroll_offset(&self, offset: Points) {
+        let y = offset.clamp(px(0.0), self.max_vertical_scroll_offset());
+        self.ed.scroll_y.set(y);
+        self.ed.vscroll.scroll_to(Point::new(px(0.0), y), false);
+    }
