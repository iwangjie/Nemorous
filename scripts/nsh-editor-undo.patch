+/// The undo and redo history of an editor at a specific document version.
+pub struct EditorUndoHistory(Buffer);
+
+impl EditorUndoHistory {
+    /// Record one text replacement while the editor view is unmounted.
+    pub fn record_replacement(
+        prior: Option<Self>,
+        before: &str,
+        after: &str,
+        caret: EditorPosition,
+    ) -> Option<Self> {
+        let mut buffer = Self::buffer_for(prior, before);
+        let selections = Selections::single(Selection::caret(buffer.offset_of(caret)));
+        buffer.set_text(after, &selections, &selections);
+        (buffer.can_undo() || buffer.can_redo()).then_some(Self(buffer))
+    }
+
+    /// Adds a source editor's model-driven edit, placing its undo caret at the change.
+    pub fn record_source_replacement(prior: Option<Self>, before: &str, after: &str) -> Option<Self> {
+        const MAX_SOURCE_STEPS: usize = 200;
+        const MAX_SOURCE_BYTES: usize = 4 * 1024 * 1024;
+
+        let mut buffer = Self::buffer_for(prior, before);
+        let caret = Selections::default();
+        let changes = buffer.set_text(after, &caret, &caret);
+        if let Some(change) = changes.first() {
+            let position = Selection::caret(change.range.start);
+            if let Some(step) = buffer.undo.back_mut() {
+                step.before = Selections::single(position);
+                step.after = Selections::single(position);
+            }
+            let step_size = |step: &Step| step.edits.iter().map(|edit| edit.old.len() + edit.new.len()).sum::<usize>();
+            let mut bytes: usize = buffer.undo.iter().map(step_size).sum();
+            while buffer.undo.len() > MAX_SOURCE_STEPS || bytes > MAX_SOURCE_BYTES {
+                if let Some(step) = buffer.undo.pop_front() {
+                    bytes -= step_size(&step);
+                }
+            }
+        }
+        (buffer.can_undo() || buffer.can_redo()).then_some(Self(buffer))
+    }
+
+    /// Undo or redo a step on the exact document version that owns it.
+    pub fn step(&mut self, expected: &str, redo: bool) -> Option<(String, EditorPosition)> {
+        if self.0.rope != expected {
+            self.0.clear_undo_history();
+            return None;
+        }
+        let (_, selections) = if redo { self.0.redo() } else { self.0.undo() }?;
+        Some((self.0.text(), self.0.position(selections.primary().head)))
+    }
+
+    fn buffer_for(prior: Option<Self>, before: &str) -> Buffer {
+        prior.filter(|history| history.0.rope == before)
+            .map_or_else(|| Buffer::new(before), |history| history.0)
+    }
+}
+
