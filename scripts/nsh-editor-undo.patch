+//! A view of a source document with extra read-only rows and line prefixes.
+//!
+//! Mutating editor commands run against the source buffer. The displayed
+//! buffer retains its own scrolling, selection, search and copy behavior.
+
+use std::{ops::Range, rc::Rc};
+
+use nsh_core::prelude::{Points, px};
+
+use super::{
+    buffer::Buffer,
+    data::EditorPosition,
+    types::{RowLayout, Selection, Selections},
+};
+
+/// The display text and the source line for each display row. A row with no
+/// source line is read-only. Prefix columns on source rows are display-only.
+pub struct EditorProjection {
+    /// The displayed document, including historical rows and prefixes.
+    pub text: String,
+    /// The zero-based source line for each displayed logical line.
+    pub source_lines: Vec<Option<u32>>,
+    /// The number of UTF-16 columns before the source content starts.
+    pub prefix_columns: u32,
+}
+
+type Render = dyn Fn(&str, &str) -> Option<EditorProjection>;
+
+pub(crate) struct Projection {
+    pub(crate) source: Buffer,
+    pub(crate) source_lines: Vec<Option<u32>>,
+    pub(crate) prefix_columns: u32,
+    pub(crate) render: Rc<Render>,
+}
+
+impl Projection {
+    pub(crate) fn source_selections(
+        &self,
+        display: &Buffer,
+        selections: &Selections,
+    ) -> Option<Selections> {
+        let position = |pos: EditorPosition| {
+            let line = *self.source_lines.get(pos.line as usize)?.as_ref()?;
+            Some(EditorPosition::new(
+                line,
+                pos.column.saturating_sub(self.prefix_columns),
+            ))
+        };
+        let selected = selections
+            .all()
+            .iter()
+            .map(|selection| {
+                let anchor = display.position(selection.anchor);
+                let head = display.position(selection.head);
+                let first = anchor.line.min(head.line) as usize;
+                let last = anchor.line.max(head.line) as usize;
+                if self
+                    .source_lines
+                    .get(first..=last)?
+                    .iter()
+                    .any(Option::is_none)
+                {
+                    return None;
+                }
+                Some(Selection::new(
+                    self.source.offset_of(position(anchor)?),
+                    self.source.offset_of(position(head)?),
+                ))
+            })
+            .collect::<Option<Vec<_>>>()?;
+        Some(Selections::new(selected, selections.primary_index()))
+    }
+
+    pub(crate) fn display_selections(
+        &self,
+        display: &Buffer,
+        selections: &Selections,
+    ) -> Selections {
+        let offset = |pos: EditorPosition| {
+            self.source_lines
+                .iter()
+                .position(|line| *line == Some(pos.line))
+                .map_or(display.len(), |row| {
+                    display.offset_of(EditorPosition::new(
+                        row as u32,
+                        pos.column.saturating_add(self.prefix_columns),
+                    ))
+                })
+        };
+        Selections::new(
+            selections
+                .all()
+                .iter()
+                .map(|selection| {
+                    Selection::new(
+                        offset(self.source.position(selection.anchor)),
+                        offset(self.source.position(selection.head)),
+                    )
+                })
+                .collect(),
+            selections.primary_index(),
+        )
+    }
+}
+
+/// Editing operations in the source use logical rows. Visual navigation goes
+/// through the display buffer and its real, wrapped layout.
+pub(crate) struct SourceRows(pub(crate) Buffer);
+
+impl RowLayout for SourceRows {
+    fn row_count(&self) -> usize {
+        self.0.line_count()
+    }
+
+    fn locate(&self, offset: usize) -> (usize, Points) {
+        let pos = self.0.position(offset);
+        (pos.line as usize, px(pos.column as f32))
+    }
+
+    fn offset_at(&self, row: usize, x: Points) -> usize {
+        self.0
+            .offset_of(EditorPosition::new(row as u32, x.0.max(0.0) as u32))
+    }
+
+    fn row_range(&self, row: usize) -> Range<usize> {
+        self.0.line_start(row)..self.0.line_end(row)
+    }
+}
