+    /// Keep a non-activating test surface from changing the system cursor.
+    #[doc(hidden)]
+    pub fn suppress_background_test_cursor(&self) -> bool {
+        if self.background_test_window().is_none() {
+            return false;
+        }
+        self.surface.input.suppress_system_cursor.set(true);
+        true
+    }
+
+    fn background_test_window(&self) -> Option<Retained<NSWindow>> {
+        let app = NSApplication::sharedApplication(self.surface.mtm);
+        let window = self.container.window()?;
+        (!app.isActive()
+            && !window.isKeyWindow()
+            && window.styleMask().contains(NSWindowStyleMask::NonactivatingPanel))
+            .then_some(window)
+    }
+
+    /// Dispatch a synthetic key to this view in a non-activating test process.
+    #[doc(hidden)]
+    pub fn dispatch_background_test_key(&self, event: &NSEvent) -> bool {
+        let Some(window) = self.background_test_window() else { return false };
+        if window.windowNumber() != event.windowNumber()
+            || !matches!(event.r#type(), NSEventType::KeyDown | NSEventType::KeyUp)
+        {
+            return false;
+        }
+        crate::window::became_key(&self.surface, &window);
+        if crate::keyboard::press(&self.surface, event) {
+            return true;
+        }
+        let Some(responder) = window.firstResponder() else { return false };
+        if !responder.downcast_ref::<NSView>()
+            .is_some_and(|view| view.isDescendantOf(self.surface.root.ns()))
+        {
+            return false;
+        }
+        if event.r#type() == NSEventType::KeyDown {
+            responder.keyDown(event);
+        } else {
+            responder.keyUp(event);
+        }
+        true
+    }
