        "workspace.read",
        "process.exec"
      ],
      "contributes": {
        "panels": [
          {
            "id": "maven",
            "title": "Maven",
            "icon": "maven"
          }
        ],
        "commands": [
          {
            "id": "maven.reload",
            "title": "Maven: 重新发现项目",
            "action": "refresh"
          },
          {
            "id": "maven.package",
            "title": "Maven: 打包当前模块",
            "action": "runPackage"
          },
          {
            "id": "maven.dependencies",
            "title": "Maven: 依赖分析",
            "action": "openDeps"
          }
        ]
      },
      "tags": [
        "java",
        "maven",
        "build"
      ],
      "official": true,
      "builtin": true
    },
    {
      "id": "markdown",
      "name": "Markdown",
      "version": "1.0.0",
      "description": "IDEA 风格 Markdown 编辑器集成：打开 .md 即自动进入双栏/预览/实时编辑，支持本地图片与保存。",
