    {
      "id": "maven",
      "name": "Maven",
      "version": "1.0.0",
      "description": "IDEA 风格的 Maven 工具窗口：模块树、生命周期目标、Profiles、依赖树、Effective POM 与实时构建输出。",
      "author": "Nemorous",
      "homepage": "https://github.com/iwangjie/Nemorous",
      "minAppVersion": "0.3.0",
      "main": "main.js",
      "icon": "maven",
