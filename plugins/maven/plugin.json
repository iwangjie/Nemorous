{
  "id": "maven",
  "name": "Maven",
  "version": "1.0.0",
  "description": "IDEA 风格的 Maven 工具窗口：模块树、生命周期目标、Profiles、依赖树、Effective POM 与实时构建输出。",
  "author": "Nemorous",
  "homepage": "https://github.com/iwangjie/Nemorous",
  "minAppVersion": "0.3.0",
  "main": "main.js",
  "icon": "icon.svg",
  "permissions": ["workspace.read", "process.exec"],
  "contributes": {
    "panels": [
      { "id": "maven", "title": "Maven", "icon": "maven" }
    ],
    "commands": [
      { "id": "maven.reload", "title": "Maven: 重新发现项目", "action": "refresh" },
      { "id": "maven.package", "title": "Maven: 打包当前模块", "action": "runPackage" },
      { "id": "maven.dependencies", "title": "Maven: 依赖分析", "action": "openDeps" }
    ]
  }
}
