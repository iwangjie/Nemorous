{
  "id": "maven",
  "name": "Maven",
  "version": "1.1.0",
  "description": "面向大型多仓 Maven 项目的构建与依赖分析：模块树、构建批次、内部依赖图、版本冲突、并发构建、JVM 参数与实时输出。",
  "author": "Nemorous",
  "homepage": "https://github.com/iwangjie/Nemorous",
  "minAppVersion": "0.5.0",
  "main": "main.js",
  "icon": "icon.svg",
  "permissions": [
    "workspace.read",
    "process.exec"
  ],
  "contributes": {
    "panels": [
      {
        "id": "maven",
        "title": "Maven",
        "icon": "maven"
      }
    ],
    "commands": [
      {
        "id": "maven.reload",
        "title": "Maven: 重新发现项目",
        "action": "refresh"
      },
      {
        "id": "maven.package",
        "title": "Maven: 打包当前模块",
        "action": "runPackage"
      },
      {
        "id": "maven.dependencies",
        "title": "Maven: 依赖分析",
        "action": "openDeps"
      },
      {
        "id": "maven.graph",
        "title": "Maven: 打开依赖关系图",
        "action": "openGraph"
      }
    ]
  }
}
